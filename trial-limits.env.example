# Apply in Render > Environment, then redeploy the updated server.
# These are cumulative shared caps, not daily limits or free Google credits.
# Keep the existing usage ledger: do not reset consumed counts.
PILOT_ROUTE_LIMIT=500
PILOT_NEARBY_LIMIT=10000
PILOT_AUTOCOMPLETE_LIMIT=500
PILOT_DETAILS_LIMIT=500
# Keep per-comparison work bounded and five-minute caching enabled.
MAX_NEARBY_QUERIES=120
