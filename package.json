{
  "name": "nightwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "server": "tsx server/index.ts",
    "android:sync": "node scripts/patch-android-map.mjs && npm run build && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build-server/index.mjs",
    "postinstall": "node scripts/patch-android-map.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/google-maps": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.58.0",
    "@types/google.maps": "3.66.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
