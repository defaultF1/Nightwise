# Frontend values are public and compiled into the app; never put server keys here.
VITE_API_BASE_URL=
# Mappls web (browser/WebView) key from https://auth.mappls.com/console, domain-restricted.
VITE_MAPPLS_WEB_KEY=
VITE_ANDROID_API_BASE_URL=https://nightwise-f5fu.onrender.com
# Server environment. Supply only when ready for live integration.
# API_PROVIDER defaults to mappls; set to google only to run the preserved legacy provider.
API_PROVIDER=mappls
# Mappls server (REST/cloud) key from https://auth.mappls.com/console. Never a VITE_ variable.
MAPPLS_SERVER_KEY=
GOOGLE_MAPS_SERVER_KEY=
ENABLE_ACTIVITY_ANALYSIS=false
ENABLE_EXPERIMENTAL_SCORING=false
PORT=8787
HOST=127.0.0.1
# Public app: PILOT_ACCESS_CODE is no longer used on this migration branch.
ALLOWED_ORIGINS=https://localhost,http://localhost,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
MAX_NEARBY_QUERIES=120
PILOT_ROUTE_LIMIT=10
PILOT_NEARBY_LIMIT=600
BUDGET_LEDGER_PATH=.local/pilot-budget.json
# Optional hosted persistent counter. Set BOTH values privately; never use VITE variables.
# When supplied, Redis replaces the file ledger and never falls back to a reset local counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENABLE_LIVE_REQUESTS=false
ENABLE_PLACE_SEARCH=false
PILOT_AUTOCOMPLETE_LIMIT=40
PILOT_DETAILS_LIMIT=20
ROAD_DATA_PATH=data/roads/north-bengaluru-22km.json
VITE_ENABLE_LIVE_MAPS=false
